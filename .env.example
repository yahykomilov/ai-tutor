# ============================================================
#  AI Tutor — пример переменных окружения.
#  Скопируй в .env и заполни. РЕАЛЬНЫЕ КЛЮЧИ НЕ КОММИТИТЬ.
#  Секретами делимся только в личке, НИКОГДА не в общий чат.
# ============================================================

# --- AI (обязательно для «живого» режима). ---
# Приоритет: GROQ_API_KEY → ANTHROPIC_API_KEY → демо-режим (заготовленные ответы).
# Groq — быстрый и бесплатный: ключ с console.groq.com
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Anthropic Claude (альтернатива)
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5

# --- Сервер ---
PORT=3001
# Через запятую, какие origin'ы пускать (CORS). Прод-домен добавить сюда.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# --- Rate limit (опционально; дефолты 20 запросов, +0.5 токен/сек) ---
RATE_CAPACITY=
RATE_REFILL=

# --- MySQL (опционально: без MYSQL_HOST сервер работает без БД) ---
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=ai_tutor
MYSQL_PASSWORD=
MYSQL_DATABASE=ai_tutor

# --- Админ (Security-дашборд /api/admin/stats) ---
ADMIN_TOKEN=

# --- Telegram бот + Mini App ---
TELEGRAM_BOT_TOKEN=
# Публичный URL веб-приложения (для кнопки «Открыть Mini App» в боте).
WEB_APP_URL=http://localhost:5173
# URL сервера, куда бот шлёт вопросы ученика.
SERVER_URL=http://localhost:3001

# --- Веб (Vite, префикс VITE_ обязателен) ---
VITE_API_URL=http://localhost:3001
