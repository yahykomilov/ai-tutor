# ============================================================
#  AI Tutor — пример переменных окружения.
#  Скопируй в .env и заполни. РЕАЛЬНЫЕ КЛЮЧИ НЕ КОММИТИТЬ.
#  Секретами делимся только в личке, НИКОГДА не в общий чат.
# ============================================================

# --- AI (обязательно для «живого» режима). ---
# Приоритет: GROQ_API_KEY → ANTHROPIC_API_KEY → демо-режим (заготовленные ответы).
# Groq — быстрый и бесплатный: ключ с console.groq.com
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Anthropic Claude (альтернатива)
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5

# Опция «движок = локальный Claude Code»: живой ИИ БЕЗ отдельного ключа —
# сервер вызывает установленный на машине claude CLI (для демо/хакатона).
# Работает только там, где запущен сервер и claude авторизован (не на Vercel).
# CLAUDE_BIN=C:\Users\<you>\AppData\Roaming\npm\node_modules\@anthropic-ai\claude-code\bin\claude.exe

# --- Сервер ---
PORT=3001
# Через запятую, какие origin'ы пускать (CORS). Прод-домен добавить сюда.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# --- Rate limit (опционально; дефолты 20 запросов, +0.5 токен/сек) ---
RATE_CAPACITY=
RATE_REFILL=

# --- MySQL (опционально: без MYSQL_HOST сервер работает без БД) ---
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=ai_tutor
MYSQL_PASSWORD=
MYSQL_DATABASE=ai_tutor

# --- Админ (Security-дашборд /api/admin/stats) ---
ADMIN_TOKEN=

# --- Telegram бот + Mini App ---
TELEGRAM_BOT_TOKEN=
# Публичный URL веб-приложения (для кнопки «Открыть Mini App» в боте).
WEB_APP_URL=http://localhost:5173
# URL сервера, куда бот шлёт вопросы ученика.
SERVER_URL=http://localhost:3001

# --- Веб (Vite, префикс VITE_ обязателен) ---
VITE_API_URL=http://localhost:3001

# --- Supabase (аккаунты Google/email + сохранение чатов). ---
# Пусто → локальный/гостевой режим (чаты хранятся в браузере).
# Заполнить → email/guest-аккаунты уже полноценные.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Google-кнопка отдельно: сначала создай OAuth client в Google Cloud Console
# (Authorized redirect URI = <VITE_SUPABASE_URL>/auth/v1/callback), вставь Client
# ID/Secret в Supabase Dashboard → Authentication → Providers → Google, добавь
# сайт в Redirect URLs. Только ПОСЛЕ этого поставь true — иначе кнопка Google
# в приложении редиректит на голую JSON-ошибку Supabase вместо аккуратного текста.
VITE_GOOGLE_AUTH_READY=false
